{
  "rules": [
    {
      "id": "status-block",
      "kind": "block",
      "role": "char",
      "start": "```status",
      "end": "```",
      "card": "Your character name"
    },
    {
      "id": "hp",
      "kind": "regex",
      "pattern": "HP\\s*[:：]\\s*(?P<value>\\d+\\s*/\\s*\\d+)",
      "key": "HP",
      "card": "Your character name"
    },
    {
      "id": "status-bar",
      "kind": "block",
      "role": "char",
      "start": "☆ \\[",
      "end": "\\]\\s*$",
      "separator": "|",
      "watch": [
        "Items",
        "Gold"
      ],
      "card": "Your character name"
    },
    {
      "id": "html-status",
      "kind": "regex",
      "pattern": "<span class=\"stat-(?P<key>[a-z]+)\">(?P<value>[^<]+)</span>",
      "card": "Your character name"
    }
  ]
}
