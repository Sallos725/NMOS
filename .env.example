# Copy to .env and fill in. .env is git-ignored.
# Bearer token. Leave empty for a loopback-only sidecar. REQUIRED (with the plugin's auth_token) if you
# bind the sidecar to a LAN/Tailscale address: without it anyone who can reach the port can read chats
# and change settings. Never expose the sidecar or Postgres to the internet (README "Security").
NMOS_AUTH_TOKEN=
# Without a token the sidecar answers only to IP addresses, localhost and single-label names (nmos,
# sidecar). Add any domain name you reach it by, e.g. a reverse proxy or tailnet name (*.ts.net covers
# subdomains; * turns the check off). Ignored when NMOS_AUTH_TOKEN is set.
NMOS_ALLOWED_HOSTS=
NMOS_DB_PASSWORD=nmos
# Origin(s) PocketRisu is opened from (must be localhost or HTTPS, see ARCHITECTURE H8), comma-separated.
NMOS_CORS_ORIGINS=http://localhost:6001
# Bind address/port of the sidecar; use a LAN/Tailscale address only if PocketRisu's browser is elsewhere.
NMOS_SIDECAR_BIND=127.0.0.1
NMOS_SIDECAR_PORT=8790
NMOS_DB_PORT=5436

# Optional: background fact extraction with any OpenAI-compatible endpoint (Ollama on the host shown).
# NMOS_LLM_URL=http://host.docker.internal:11434/v1
# NMOS_LLM_MODEL=
# NMOS_LLM_API_KEY=
# NMOS_EXTRACT_BACKFILL=100   # turns extracted when a chat is first seen
# NMOS_EXTRACT_TURNS=3        # previous turns an extraction sees as context
# NMOS_EXTRACT_HINTS=40       # earlier entity names shown to extraction (0 = off)
# NMOS_WORKER_CONCURRENCY=2

# Optional: semantic recall.
# NMOS_EMBED_URL=http://host.docker.internal:11434/v1
# NMOS_EMBED_MODEL=qwen3-embedding:0.6b

# Optional: status-window parser rules (./config is mounted at /config).
# NMOS_PARSERS_FILE=/config/parsers.json
