# Copy to .env and fill in. .env is git-ignored.
# Bearer token. Leave empty for a loopback-only sidecar. REQUIRED (with the plugin's auth_token) if you
# bind the sidecar to a LAN/Tailscale address: without it anyone who can reach the port can read chats
# and change settings. Never expose the sidecar or Postgres to the internet (README "Security").
NMOS_AUTH_TOKEN=
# Without a token the sidecar answers only to IP addresses, localhost and single-label names (nmos,
# sidecar). Add any domain name you reach it by, e.g. a reverse proxy or tailnet name (*.ts.net covers
# subdomains; * turns the check off). Ignored when NMOS_AUTH_TOKEN is set.
NMOS_ALLOWED_HOSTS=
NMOS_DB_PASSWORD=nmos
# Origin(s) PocketRisu is opened from (must be localhost or HTTPS, see ARCHITECTURE H8), comma-separated.
NMOS_CORS_ORIGINS=http://localhost:6001
# Bind address/port of the sidecar; use a LAN/Tailscale address only if PocketRisu's browser is elsewhere.
NMOS_SIDECAR_BIND=127.0.0.1
NMOS_SIDECAR_PORT=8790
NMOS_DB_PORT=5436

# Optional: background fact extraction with any OpenAI-compatible endpoint (Ollama on the host shown).
# NMOS_LLM_URL=http://host.docker.internal:11434/v1
# NMOS_LLM_MODEL=
# NMOS_LLM_API_KEY=
# NMOS_LLM_EXTRA_BODY=       # JSON object added to every request to the extraction model (PHASE-61 S1),
#                            # in single quotes: '{"reasoning": {"effort": "low"}}'; empty = {}; no request field (model,
#                            # messages, temperature, response_format, ...), no key (that is NMOS_LLM_API_KEY);
#                            # at most 2,048 bytes
# NMOS_LLM_NO_TEMPERATURE=0  # 1: send no temperature, for a model that refuses one (PHASE-61 S1b); 0 = send 0
# NMOS_EXTRACT_BACKFILL=100   # turns extracted when a chat is first seen
# NMOS_EXTRACT_COMPILER=      # empty: extract-v16; extract-v19 selectable (switching from extract-v16/-v18 queues nothing)
# NMOS_EXTRACT_TARGET_CHARS=  # empty: 6000. Normalized characters of each message the extraction model is shown (a turn's
#                             # messages, a scene summary's): replies longer than this are read only up to it (K13). Up to
#                             # 36000. A change queues nothing; turns already read keep their facts until the panel's
#                             # "Read the cut turns again". A longer cap costs more input on every long turn (PHASE-62).
# NMOS_SUMMARIES=1            # scene summaries by the extraction model, in <Story> (0 = off)
# NMOS_CANON_FACTS=1          # facts the extraction model reads from the card, persona, note and lorebook entries a prompt held (0 = off)
# NMOS_EXTRACT_TURNS=3        # previous turns an extraction sees as context
# NMOS_EXTRACT_HINTS=40       # earlier entity names shown to extraction (0 = off)
# NMOS_WORKER_CONCURRENCY=2

# Optional: semantic recall.
# NMOS_EMBED_URL=http://host.docker.internal:11434/v1
# NMOS_EMBED_MAX_CHUNKS=8    # chunks of 700 characters embedded per message (ADR 0062); part of the projection: a change re-embeds
# NMOS_EMBED_MODEL=qwen3-embedding:0.6b

# Optional: reranker (PHASE-60 S5, ADR 0084). Off unless both URL and model are set; when on, the user's message and
# the text of up to 30 recalled candidates go to that endpoint. The key is a credential (never archived or logged).
# Only `standard` exists.
# NMOS_RERANK_URL=
# NMOS_RERANK_MODEL=
# NMOS_RERANK_API_KEY=
# NMOS_RERANK_TIMEOUT_MS=600  # 50-5000; keep NMOS_EMBED_TIMEOUT_MS + this well under the plugin's deadline (3000 ms by default)
# NMOS_RERANK_FORMAT=standard

# Optional: the packet. Empty is the image's default (packet-v19); packet-v20 (PHASE-60) is selectable, not the default.
# NMOS_PACKET_POLICY=
# NMOS_PIN_AT_MENTIONS=0     # the `@name` pin setting (PHASE-60 S8, ADR 0087); empty or 0 = off

# Optional: status-window parser rules (./config is mounted at /config).
# NMOS_PARSERS_FILE=/config/parsers.json
